  "item": [
    {
      "name": "GET Post by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Проверяем, что статус-код равен 200\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Проверяем, что в ответе есть поле userId\r",
              "pm.test(\"Response has userId field\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.userId).to.be.a('number');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      },
      "response": []
    },
